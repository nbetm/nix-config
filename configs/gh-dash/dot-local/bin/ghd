#!/usr/bin/env bash
#
# Description: Wrap gh-dash so it injects the current repo into repoPaths
#
# Set options:
#   e: Stop script if command fails
#   u: Stop script if unset variable is referenced
#   o pipefail: If any command in a pipeline fails it all fails
#
set -euo pipefail

REPO=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null)
REPO_PATH=$(git rev-parse --show-toplevel 2>/dev/null)

if [[ -n "$REPO" ]] && [[ -n "$REPO_PATH" ]]; then
    export REPO REPO_PATH
    gh-dash --config <(
        yq '.repoPaths[strenv(REPO)] = strenv(REPO_PATH)' ~/.config/gh-dash/config.yml
    )
else
    gh-dash
fi
