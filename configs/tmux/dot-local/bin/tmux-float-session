#!/usr/bin/env bash
#
# Description: Manage per-window floating panes
#
# Set options:
#   e: Stop script if command fails
#   u: Stop script if unset variable is referenced
#   o pipefail: If any command in a pipeline fails it all fails
#
set -euo pipefail

# -----------------------------------------------------------------------------
# Constants
# -----------------------------------------------------------------------------

TMUX_FLOAT_WIDTH="${TMUX_FLOAT_WIDTH:-70%}"
TMUX_FLOAT_HEIGHT="${TMUX_FLOAT_HEIGHT:-70%}"
# cleanup, tmux-session-cycle, and the sesh.toml blacklist all find parked floats
# by this suffix.
FLOAT_SUFFIX="-float"

# -----------------------------------------------------------------------------
# Helpers
# -----------------------------------------------------------------------------

_park_name() {
    local win="$1" park
    park="$(tmux show-option -wqv -t "$win" @float_session)"
    if [[ -z "$park" ]]; then
        park="$(tmux display-message -p -t "$win" '#{session_name}')-$(printf '%04x' "${RANDOM}")${FLOAT_SUFFIX}"
        tmux set-option -w -t "$win" @float_session "$park"
    fi
    printf '%s' "$park"
}

_zoomed_pane() {
    tmux list-panes -t "$1" -F '#{?pane_zoomed_flag,#{pane_id},}' | grep . || true
}

# Moving a pane between windows unzooms the window, even with swap-pane -Z.
_rezoom() {
    local win="$1" zoomed="$2"
    if [[ -n "$zoomed" && "$(tmux display-message -p -t "$win" '#{window_zoomed_flag}')" == 0 ]]; then
        tmux resize-pane -Z -t "$zoomed"
    fi
}

# -----------------------------------------------------------------------------
# toggle
# -----------------------------------------------------------------------------

_float_open() {
    local win="$1" pane
    pane="$(tmux new-pane -A -t "$win" -c '#{pane_current_path}' \
        -x "$TMUX_FLOAT_WIDTH" -y "$TMUX_FLOAT_HEIGHT" -P -F '#{pane_id}')"
    tmux move-pane -t "$pane" -P centre
    tmux set-option -w -t "$win" @float_pane "$pane"
}

# break-pane would park the float at the parking session's size and make it
# redraw. Swapping with a placeholder of the float's size moves it without a
# resize.
_float_park() {
    local win="$1" pane="$2" park="$3" zoomed x y w h holder
    zoomed="$(_zoomed_pane "$win")"
    read -r x y w h <<<"$(tmux display-message -p -t "$pane" \
        '#{pane_left} #{pane_top} #{pane_width} #{pane_height}')"
    tmux set-option -w -t "$win" @float_geometry "$x $y $w $h"

    tmux kill-session -t "=${park}" 2>/dev/null || true
    holder="$(tmux new-session -d -s "$park" -x "$w" -y "$h" -E -P -F '#{pane_id}')"
    tmux swap-pane -d -s "$pane" -t "$holder"
    tmux kill-pane -t "$holder"
    _rezoom "$win" "$zoomed"
}

_float_restore() {
    local win="$1" pane="$2" zoomed x y w h win_w win_h holder
    zoomed="$(_zoomed_pane "$win")"
    read -r x y w h <<<"$(tmux show-option -wqv -t "$win" @float_geometry)"
    read -r win_w win_h <<<"$(tmux display-message -p -t "$win" '#{window_width} #{window_height}')"

    # pane_left and pane_width describe the content area. new-pane -X and -x size
    # the box, border included.
    x=$((x - 1)) y=$((y - 1)) w=$((w + 2)) h=$((h + 2))
    if ((w > win_w)); then w=$win_w; fi
    if ((h > win_h)); then h=$win_h; fi
    if ((x + w > win_w)); then x=$((win_w - w)); fi
    if ((y + h > win_h)); then y=$((win_h - h)); fi
    if ((x < 0)); then x=0; fi
    if ((y < 0)); then y=0; fi

    holder="$(tmux new-pane -A -d -t "$win" -X "$x" -Y "$y" -x "$w" -y "$h" -E -P -F '#{pane_id}')"
    tmux swap-pane -d -s "$pane" -t "$holder"
    tmux kill-pane -t "$holder"
    _rezoom "$win" "$zoomed"
    tmux select-pane -Z -t "$pane"
}

float_toggle() {
    local win pane park info pane_win floating session
    win="$(tmux display-message -p '#{window_id}')"
    pane="$(tmux show-option -wqv -t "$win" @float_pane)"
    park="$(_park_name "$win")"

    if [[ -n "$pane" ]] && info="$(tmux display-message -p -t "$pane" \
        '#{window_id} #{pane_floating_flag} #{session_name}' 2>/dev/null)"; then
        read -r pane_win floating session <<<"$info"
        if [[ "$pane_win" == "$win" && "$floating" == 1 ]]; then
            _float_park "$win" "$pane" "$park"
            return 0
        fi
        if [[ "$session" == "$park" ]]; then
            _float_restore "$win" "$pane"
            return 0
        fi
    fi

    _float_open "$win"
}

# -----------------------------------------------------------------------------
# cleanup
# -----------------------------------------------------------------------------

# Runs from window-unlinked and session-closed, where the window holding the
# reference may already be gone.
float_cleanup() {
    local floats referenced="" target val float

    floats="$(tmux list-sessions -F '#{session_name}' 2>/dev/null |
        grep -- "${FLOAT_SUFFIX}\$" || true)"
    if [[ -z "$floats" ]]; then
        return 0
    fi

    while IFS= read -r target; do
        val="$(tmux show-option -wqv -t "$target" @float_session 2>/dev/null || true)"
        if [[ -n "$val" ]]; then
            referenced="${referenced}${val}"$'\n'
        fi
    done < <(tmux list-windows -a -F '#{session_name}:#{window_index}' 2>/dev/null)

    while IFS= read -r float; do
        if [[ -z "$float" ]]; then
            continue
        fi
        if ! printf '%s' "$referenced" | grep -qxF "$float"; then
            tmux kill-session -t "=${float}" 2>/dev/null || true
        fi
    done <<<"$floats"
}

# -----------------------------------------------------------------------------
# Usage / dispatch
# -----------------------------------------------------------------------------

show_usage() {
    cat <<'EOF'
Usage: tmux-float-session <command>

Commands:
    toggle        Show the window's float, or park it if visible (default)
    cleanup       Kill parked floats no window references (hook-driven)
    help          Show this help message

Environment:
    TMUX_FLOAT_WIDTH   Float width (default: 70%)
    TMUX_FLOAT_HEIGHT  Float height (default: 70%)

EOF
}

main() {
    if [[ -z "${TMUX:-}" ]]; then
        exit 0
    fi

    local command="${1:-toggle}"

    case "$command" in
        toggle) float_toggle ;;
        cleanup) float_cleanup ;;
        help | --help | -h) show_usage ;;
        *)
            echo "Error: Unknown command: $command" >&2
            echo
            show_usage
            exit 1
            ;;
    esac
}

main "$@"
