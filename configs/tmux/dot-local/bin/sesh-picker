#!/usr/bin/env bash
#
# Description: Interactive session picker using sesh and fzf
#
# Supports switching between tmux sessions, config dirs, and zoxide paths.
# The blacklist in sesh.toml hides the internal -float and -stack sessions.
#
# Set options:
#   e: Stop script if command fails
#   u: Stop script if unset variable is referenced
#   o pipefail: If any command in a pipeline fails it all fails
#
set -euo pipefail

# Best effort. fzf wants a terminal on stdin, but under `run-shell` there is no
# controlling terminal and /dev/tty cannot be opened. fzf-tmux does not need one
# there, drawing in a tmux popup instead.
exec </dev/tty 2>/dev/null || true
exec <&1
session=

# A running session that also has a sesh.toml entry lists twice. fzf runs
# reload() actions through sh, which cannot call _dedupe. DEDUPE holds the same
# awk as a string for them. Expanding DEDUPE unquoted in a pipeline would hand
# awk the quote characters literally.
_dedupe() { awk '!seen[$0]++'; }
DEDUPE="awk '!seen[\$0]++'"

# Shared sesh fzf configuration
sesh_fzf_args=(
    --border-label " sesh "
    --preview-window "right:50%"
    --preview "sesh preview {}"
    --prompt "❱ "
    --list-border
    --header-border
    --header "<C-t> 󰕮  │ <C-b> 󰃀  │ <C-f> 󰉋  │ <C-a>   │ <C-r>   │ <A-del>  "
    --bind "tab:down,btab:up,ctrl-n:down,ctrl-p:up"
    --bind "ctrl-d:preview-half-page-down,ctrl-u:preview-half-page-up"
    --bind "ctrl-t:change-prompt(󰕮  )+reload(sesh list -t)"
    --bind "ctrl-b:change-prompt(󰃀  )+reload(sesh list -c)"
    --bind "ctrl-f:change-prompt(󰉋  )+reload(sesh list -z)"
    --bind "ctrl-a:change-prompt(  )+reload(sesh list | ${DEDUPE})"
    --bind "ctrl-r:change-prompt(❱ )+reload(sesh list -t -c | ${DEDUPE})"
    --bind "alt-bspace:execute-silent(tmux kill-session -t {})+change-prompt(❱ )+reload(sesh list -t -c | ${DEDUPE})"
)

# `|| true` because fzf reports a cancelled pick as a failure: 130 for Esc or
# Ctrl-C, 1 for no match. Under `set -e` that would abort here, before the empty
# selection below is ever considered.
if [[ -n "${TMUX:-}" ]]; then
    session=$(sesh list -t -c | _dedupe | fzf-tmux -p 50%,60% "${sesh_fzf_args[@]}") || true
else
    session=$(sesh list -t -c | _dedupe | fzf --height 60% "${sesh_fzf_args[@]}") || true
fi

if [[ -n "$session" ]]; then
    sesh connect "$session"
fi
