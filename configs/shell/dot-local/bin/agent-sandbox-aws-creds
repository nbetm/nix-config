#!/usr/bin/env bash
#
# Description: Stage short-lived AWS credentials for agent sandboxes
#
# Set options:
#   e: Stop script if command fails
#   u: Stop script if unset variable is referenced
#   o pipefail: If any command in a pipeline fails it all fails
#
set -euo pipefail

REGION="${AWS_REGION:-us-east-2}"
STAGE_DIR="${STAGE_DIR:-$HOME/.aws/agent-sandbox}"
PROFILES=(
    px-management-ro
    px-development-ro
    px-production-ro
    px-development-devbox
)

CREDS_FILE="${STAGE_DIR}/credentials"
CONFIG_FILE="${STAGE_DIR}/config"

show_usage() {
    cat <<EOF
Usage: agent-sandbox-aws-creds

Stage short-lived AWS credentials for agent sandboxes.
The script exports each profile below from your SSO session.
It writes them as a credentials and config pair under ${STAGE_DIR}.
agent-sandbox mounts that directory as a read-only ~/.aws in each new sandbox.

Profiles:
$(printf '  %s\n' "${PROFILES[@]}")

Log in first. The shared px-systems SSO session covers every profile.

  aws sso login --profile px-management
  agent-sandbox-aws-creds

awsl runs this script after every px-* login.
EOF
    exit 1
}

[[ "${1:-}" =~ ^(-h|--help|help)$ ]] && show_usage

for cmd in aws jq; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        echo "Error: $cmd not found" >&2
        exit 1
    fi
done

mkdir -p "$STAGE_DIR"
chmod 700 "$STAGE_DIR"

# Start fresh so a removed profile never lingers in the staged files
: >"$CREDS_FILE"
: >"$CONFIG_FILE"
chmod 600 "$CREDS_FILE" "$CONFIG_FILE"

expires=""
for profile in "${PROFILES[@]}"; do
    echo -n "Staging ${profile}... "
    if ! creds=$(aws configure export-credentials --profile "$profile" 2>/dev/null); then
        echo "failed!"
        echo "Error: could not export ${profile}." \
            "Is it configured and your SSO session active? Run: awsl" >&2
        exit 1
    fi

    cat >>"$CREDS_FILE" <<EOF
[${profile}]
aws_access_key_id = $(jq -r '.AccessKeyId' <<<"$creds")
aws_secret_access_key = $(jq -r '.SecretAccessKey' <<<"$creds")
aws_session_token = $(jq -r '.SessionToken' <<<"$creds")

EOF

    cat >>"$CONFIG_FILE" <<EOF
[profile ${profile}]
region = ${REGION}
output = json

EOF

    expires=$(jq -r '.Expiration' <<<"$creds")
    echo "done!"
done

echo ""
echo "Staged ${#PROFILES[@]} profiles under ${STAGE_DIR} (expires ${expires})"
